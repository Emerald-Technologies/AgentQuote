FOUNDRY_PROJECT_ENDPOINT="https://et-foundry-e2.services.ai.azure.com/api/projects/CodingAssistant"
# AZURE_AI_MODEL_DEPLOYMENT_NAME_PRO=DeepSeek-V4-Pro
AZURE_AI_MODEL_DEPLOYMENT_NAME_FLASH=DeepSeek-V4-Flash
BOM_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=etbomstorage;AccountKey=REPLACE_WITH_STORAGE_KEY;BlobEndpoint=https://etbomstorage.blob.core.windows.net/;FileEndpoint=https://etbomstorage.file.core.windows.net/;QueueEndpoint=https://etbomstorage.queue.core.windows.net/;TableEndpoint=https://etbomstorage.table.core.windows.net/"

# Deterministic API (run separately from main.py / the Responses service).
# Production must use easy_auth and Azure Container Apps Authentication.
BOM_STORAGE_ACCOUNT_URL=https://etbomstoragegov.blob.core.usgovcloudapi.net
# Optional for a user-assigned identity; omit for the system-assigned identity.
# BOM_STORAGE_MANAGED_IDENTITY_CLIENT_ID=REPLACE_WITH_CLIENT_ID
BOM_API_AUTH_MODE=easy_auth
BOM_API_ALLOWED_APP_IDS=REPLACE_WITH_QUICK_QUOTE_WORKLOAD_APP_ID
# BOM_API_ALLOWED_OBJECT_IDS=REPLACE_WITH_QUICK_QUOTE_SERVICE_PRINCIPAL_OBJECT_ID
BOM_API_PORT=8088
BOM_API_MAX_BODY_BYTES=131072
BOM_API_MAX_CONCURRENT_JOBS=2
BOM_PROCESS_TIMEOUT_SECONDS=60
BOM_MAX_SOURCE_BYTES=50000000
BOM_MAX_TOTAL_SOURCE_BYTES=100000000
BOM_MAX_PARSER_BYTES=1000000
BOM_MAX_OUTPUT_BYTES=50000000
BOM_MAX_ROWS=100000

# Fresh enrollment only. Prefer a bounded quote UUID list for canaries; no wildcard.
# Removing UUIDs stops new enrollment, not accounting for already enrolled requests.
BOM_AUTHOR_GROUP_BUDGET=false
BOM_AUTHOR_GROUP_BUDGET_QUOTE_UUIDS=